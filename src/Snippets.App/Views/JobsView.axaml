<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Snippets.App.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Snippets.App.Views.JobsView"
             x:DataType="vm:JobsViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.jobList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.jobList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.jobList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.jobList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*">
    <TextBlock Grid.Row="0" FontSize="28" FontWeight="SemiBold" Text="Jobs" />
    <TextBlock Grid.Row="1" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
               Text="Manage trigger + action jobs such as clip.poll and clip.prune." />

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0"
               VerticalAlignment="Center">
      <Button Click="OnOpenConfigFolderClick" ToolTip.Tip="Open config folder">
        <ic:SymbolIcon Symbol="FolderOpen" FontSize="14" />
      </Button>
      <Button Click="OnRefreshClick" ToolTip.Tip="Refresh jobs from config">
        <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
      </Button>
      <Border Padding="10,6" CornerRadius="10"
              HorizontalAlignment="Left"
              Background="{DynamicResource ControlFillColorSecondaryBrush}">
        <TextBlock Text="{Binding SummaryText}" FontSize="12" />
      </Border>
    </StackPanel>

    <TextBlock Grid.Row="3" Margin="0,10,0,0"
               Text="{Binding RefreshStatusText}"
               IsVisible="{Binding HasRefreshStatus}"
               TextWrapping="Wrap"
               Opacity="0.75" />

    <ListBox Grid.Row="4" Margin="0,16,0,0"
             Classes="jobList"
             ItemsSource="{Binding Jobs}"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:JobCardViewModel">
          <Border Padding="16" Margin="0,0,0,10"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="6" BorderThickness="1"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                  <Border Padding="8,4" CornerRadius="10" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding StateText}"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Grid Width="8" Height="8" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               IsVisible="{Binding HasActiveStatus}"
                               Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               IsVisible="{Binding HasPausedStatus}"
                               Fill="{DynamicResource SystemFillColorCautionBrush}" />
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               IsVisible="{Binding HasNeutralStatus}"
                               Fill="{DynamicResource TextFillColorDisabledBrush}" />
                    </Grid>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}"
                           FontSize="12" Opacity="0.6" />
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Top">
                <Button Click="OnToggleClick"
                        ToolTip.Tip="{Binding ToggleButtonText}"
                        IsVisible="{Binding CanToggle}"
                        IsEnabled="{Binding IsToggleEnabled}">
                  <Panel>
                    <ic:SymbolIcon Symbol="Pause" FontSize="14" IsVisible="{Binding IsRunning}" />
                    <ic:SymbolIcon Symbol="Play" FontSize="14" IsVisible="{Binding !IsRunning}" />
                  </Panel>
                </Button>
                <Button Click="OnRunNowClick"
                        ToolTip.Tip="{Binding RunButtonText}"
                        IsVisible="{Binding CanRunNow}"
                        IsEnabled="{Binding IsRunNowEnabled}">
                  <ic:SymbolIcon Symbol="Play" FontSize="14" />
                </Button>
              </StackPanel>

              <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"
                    ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trigger" FontWeight="SemiBold" Opacity="0.75" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,24,0"
                           Text="{Binding TriggerDisplay}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Action" FontWeight="SemiBold" Opacity="0.75" />
                <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,0,0"
                           Text="{Binding ActionDisplay}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"
                           Text="Last run" FontWeight="SemiBold" Opacity="0.75" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,8,24,0"
                           Text="{Binding LastFinishedText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                           Text="Result" FontWeight="SemiBold" Opacity="0.75" />
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="8,8,0,0"
                           Text="{Binding LastResultText}" TextWrapping="Wrap" />
              </Grid>

              <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                      Padding="10,8" CornerRadius="4"
                      Background="{DynamicResource ControlAltFillColorTertiaryBrush}">
                <TextBlock Text="{Binding LastDetailText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="12" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
